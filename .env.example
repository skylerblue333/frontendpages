# SKYCOIN4444 environment template
# Never commit real values. Inject secrets through the approved secret manager.

NODE_ENV=development
PORT=3000

# Required for database-backed routes and migrations.
# Use a staging-only MySQL/TiDB URL in the approved environment; do not paste it here.
DATABASE_URL=

# OAuth/provider configuration. Values must be injected server-side.
VITE_APP_ID=
OAUTH_SERVER_URL=
OAUTH_CALLBACK_URL=

# Server-side integration secrets. Keep blank in source control.
JWT_SECRET=
FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=

# Optional provider settings; configure only when independently approved.
AWS_REGION=us-east-1
S3_BUCKET=

# Production must fail closed when required secrets are absent.
